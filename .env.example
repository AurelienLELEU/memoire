# ============================================================
# Azure OpenAI (LLM + embeddings ada-002)
# ============================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Deployment names (à adapter selon ton portail Azure)
AZURE_DEPLOYMENT_GPT35=gpt-35-turbo
# AZURE_DEPLOYMENT_GPT4=gpt-4o
AZURE_DEPLOYMENT_ADA002=text-embedding-ada-002
AZURE_DEPLOYMENT_EMBED3_LARGE=text-embedding-3-large

# ============================================================
# HuggingFace (optionnel, pour modèles gated)
# ============================================================
HF_TOKEN=

# ============================================================
# Device
# ============================================================
# auto | cuda | cuda:0 | cpu
DEVICE=auto

# Optionnel : limiter VRAM pour HF (utile sur 2080 Ti 11 Go)
TORCH_CUDA_ARCH_LIST=7.5
